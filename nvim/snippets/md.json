{
  "Math Block support newline": {
    "prefix": "mbl",
    "body": [
      "```tex",
      "\\begin{equation}",
      "\\begin{aligned}",
      "${1:Type your equations here!!!}",
      "\\end{aligned}",
      "\\end{equation}",
      "```",
      "",
      "$$",
      "\\begin{aligned}",
      "${1}",
      "\\end{aligned}",
      "$$",
      "",
      "${2}"
    ],
    "description": "Generate code block and rendering-enable syntax in Neovim and Obsidian"
  },
  "Callout To Long Did not Read": {
    "prefix": "tldr",
    "body": ["> [!TLDR]", "> ${1}"]
  },
  "Callout Todo": {
    "prefix": "todo",
    "body": ["> [!TODO]", "> ${1}"]
  },
  "Callout Success": {
    "prefix": "success",
    "body": ["> [!SUCCESS]", "> ${1}"]
  },
  "Callout Question ": {
    "prefix": "question",
    "body": ["> [!QUESTION]", "> ${1}"]
  },
  "Callout Failure ": {
    "prefix": "failure",
    "body": ["> [!FAILURE]", "> ${1}"]
  },
  "Callout Bug": {
    "prefix": "bug",
    "body": ["> [!BUG]", "> ${1}"]
  },
  "Callout Example": {
    "prefix": "example",
    "body": ["> [!EXAMPLE]", "> ${1}"]
  },
  "Template _ Daily Log": {
    "prefix": "template-dailylog",
    "body": [
      "---",
      "created:",
      "    - ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      "tags:",
      "    - log/dailylog",
      "---",
      "",
      "# 📅 Daily Log ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      "",
      "---",
      "",
      "BE BETTER AND BETTER",
      "",
      "---",
      "",
      "## 🚀 To-do",
      "",
      "## 📕 Reminders",
      "",
      "$0"
    ],
    "description": "Insert daily log template with current date"
  },
  "Template _ Note": {
    "prefix": "template-note",
    "body": [
      "---",
      "aliases:",
      "date: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
      "tags:",
      "---",
      "",
      "# $TM_FILENAME_BASE",
      "",
      "$1"
    ]
  },
  "Template _ PeopleInfo": {
    "prefix": "template-people",
    "body": [
      "---",
      "aliases: ${TM_FILENAME_BASE}",
      "created: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
      "tags:",
      "    - $1",
      "peopleContact: \"\"",
      "---",
      "",
      "---",
      "",
      "Name:",
      "BOD:",
      "Email:",
      "Social media:",
      "",
      "$2"
    ]
  },
  "Template _ Project Info": {
    "prefix": "template-projectInfo",
    "body": [
      "---",
      "created:",
      "    - \"$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE $CURRENT_HOUR:$CURRENT_MINUTE\"",
      "aliases:",
      "    - Project Schedule",
      "tags:",
      "    - $1",
      "status:",
      "deadline:",
      "---",
      "",
      "# 🚀 Project ->",
      "",
      "---",
      "",
      "## 🧾 Project Description",
      "",
      "---",
      "",
      "## 📢 Project information",
      "",
      "Created:: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE $CURRENT_HOUR:$CURRENT_MINUTE",
      "Deadline::",
      "Hibernating::",
      "Completion date expected::",
      "Completed::",
      "Type::",
      "Tags::",
      "Platform::",
      "",
      "---",
      "",
      "## 🎯 Objective",
      "",
      "1. 🟢 Ideal project result",
      "    1.",
      "2. 🟠 Acceptable result",
      "    1.",
      "",
      "## ❓ Expectations",
      "",
      "1. 🟢 Helpful to the project",
      "    1.",
      "2. 🟠 Roadblocks",
      "    1.",
      "3. 👶 Naivety",
      "    1.",
      "4. 👨‍💻 Insights",
      "    1.",
      "",
      "## ✅ Tasks",
      "",
      "-",
      "",
      "## 📦 Resources",
      "",
      "-",
      "",
      "## 📂 Project Logs",
      "",
      "-",
      "",
      "$2"
    ]
  }
}
